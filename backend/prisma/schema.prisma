generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(cuid())
  phone                String         @unique
  email                String?        @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  fullName             String?
  hasPurchasedProperty Boolean        @default(false)
  createdby_admin      Boolean        @default(false)
  profileUrl           String?
  favoriteProperties   String[]       @default([])
  pushToken            String?
  role                 UserRole       @default(USER)
  sessions             Session[]
  documents            UserDocument[]
  investments          Investment[]
  builderProperties    Property[]     @relation("BuilderProperties")
}

enum UserRole {
  USER
  BUILDER
}

model Admin {
  id               String    @id @default(cuid())
  phone            String    @unique
  password         String?
  securityQuestion String?
  securityAnswer   String?
  otp              String?
  otp_expiry       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sessions         Session[]
}

model Session {
  id                String   @id @default(cuid())
  userId            String?
  adminId           String?
  refreshToken      String   @unique
  deviceFingerprint String
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  admin             Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id         String   @id @default(cuid())
  phone      String   @unique
  otp        String
  otp_expiry DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Property {
  id              String                 @id @default(cuid())
  title           String
  description     String
  images          String[]
  location        String
  mapLocation     Json?
  status          PropertyStatus         @default(AVAILABLE)
  targetReturn    Float
  minInvestment   Float
  investors       Int                    @default(0)
  totalPrice      Float
  totalSize       Float                  // area in sq.ft (numeric)
  totalUnits      Int                    @default(0) // floor(totalPrice / totalSize)
  perUnitPrice    Float                  @default(0) // totalPrice / totalUnits
  purchasedUnits  Int                    @default(0) // sum of PENDING+APPROVED investments
  category        PropertyCategory
  youtubeVideoUrl String?
  termPeriodYears Int?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  builderId       String?
  builder         User?                  @relation("BuilderProperties", fields: [builderId], references: [id])
  priceHistory    PropertyPriceHistory[]
  investments     Investment[]
}

model PropertyPriceHistory {
  id         String   @id @default(cuid())
  propertyId String
  price      Float
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model UserDocument {
  id                String         @id @default(cuid())
  userId            String
  documentType      String         @default("AADHAAR")
  documentUrl       String?
  documentNo        String?
  status            DocumentStatus @default(PENDING)
  remark            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  backImageUrl      String?
  frontImageUrl     String?
  isUploadedByAdmin Boolean        @default(false)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  UNDER_REVIEW
  COMING_SOON
  PENDING_APPROVAL
  REJECTED
  DRAFT
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  LAND
  OTHERS
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Investment {
  id              String           @id @default(cuid())
  propertyId      String
  userId          String
  units           Int              // number of units the user is buying
  unitPriceAtTime Float            // perUnitPrice snapshot at investment creation time
  totalAmount     Float            // units × unitPriceAtTime
  status          InvestmentStatus @default(PENDING)
  paymentRef      String?          // future payment gateway reference
  paymentProofs   String[]         @default([]) // array of payment proof URLs
  signatureBase64 String?          // saved signature to generate PDF later
  placeOfSignature String?         // saved place of signature
  agreementUrl    String?          // generated PDF agreement URL (only set when APPROVED)
  adminRemark     String?          // admin note on approve/reject
  paidAmount      Float            @default(0) // cumulative amount approved by admin
  paymentHistory  Json             @default("[]") // track individual approved payments [{ date, amount }]
  invoices        String[]         @default([]) // array of generated invoice PDF URLs
  refundBankDetails Json?          // stored structured bank details for refund
  refundProofUrl  String?          // admin's proof of refund payment
  maturityDate    DateTime?        // calculated term maturity date
  targetReturnAtTime Float         @default(0) // snapshot of property targetReturn
  promisedReturnAmount Float       @default(0) // calculated promised return amount
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
  @@index([status])
}

enum InvestmentStatus {
  PENDING           // user clicked pay — awaiting admin approval
  PARTIAL_PAID      // admin accepted partial payment
  APPROVED          // admin confirmed the full investment
  REFUND_REQUESTED  // user requested a refund for partial payment
  REFUNDED          // admin processed the refund
  REJECTED          // admin rejected it (units released back)
  CANCELLED         // user cancelled before admin acted (units released back)
  WITHDRAWAL_REQUESTED // user requested withdrawal after maturity
  WITHDRAWN
}
