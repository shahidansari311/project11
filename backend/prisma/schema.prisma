generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(cuid())
  phone                String         @unique
  email                String?        @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  fullName             String?
  hasPurchasedProperty Boolean        @default(false)
  createdby_admin      Boolean        @default(false)
  profileUrl           String?
  favoriteProperties   String[]       @default([])
  sessions             Session[]
  documents            UserDocument[]
}

model Admin {
  id         String    @id @default(cuid())
  phone      String    @unique
  otp        String?
  otp_expiry DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sessions   Session[]
}

model Session {
  id                String   @id @default(cuid())
  userId            String?
  adminId           String?
  refreshToken      String   @unique
  deviceFingerprint String
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  admin             Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id         String   @id @default(cuid())
  phone      String   @unique
  otp        String
  otp_expiry DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Property {
  id            String                 @id @default(cuid())
  title         String
  description   String
  images        String[]
  location      String
  status        PropertyStatus         @default(AVAILABLE)
  targetReturn  Float
  minInvestment Float
  investors     Int                    @default(0)
  totalPrice    Float
  totalSize     String
  category      PropertyCategory
  youtubeVideoUrl String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  priceHistory  PropertyPriceHistory[]
}

model PropertyPriceHistory {
  id         String   @id @default(cuid())
  propertyId String
  price      Float
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model UserDocument {
  id                String         @id @default(cuid())
  userId            String
  documentType      String         @default("AADHAAR")
  documentUrl       String?
  documentNo        String?
  status            DocumentStatus @default(PENDING)
  remark            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  backImageUrl      String?
  frontImageUrl     String?
  isUploadedByAdmin Boolean        @default(false)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  UNDER_REVIEW
  COMING_SOON
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  LAND
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}
