generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  phone                String    @unique
  fullName             String?
  email                String?   @unique
  profileUrl           String?
  hasPurchasedProperty Boolean   @default(false)
  createdby_admin      Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  sessions             Session[]
  favoriteProperties   String[]  @default([])
}

model Admin {
  id         String    @id @default(cuid())
  phone      String    @unique
  otp        String?
  otp_expiry DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sessions   Session[]
}

model Session {
  id                String   @id @default(cuid())
  userId            String?
  adminId           String?
  refreshToken      String   @unique
  deviceFingerprint String
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id         String   @id @default(cuid())
  phone      String   @unique
  otp        String
  otp_expiry DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  UNDER_REVIEW
  COMING_SOON
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  LAND
}

model Property {
  id            String           @id @default(cuid())
  title         String
  description   String
  images        String[]
  location      String
  status        PropertyStatus   @default(AVAILABLE)
  targetReturn  Float
  minInvestment Float
  investors     Int              @default(0)
  totalPrice    Float
  totalSize     String
  category      PropertyCategory
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}
