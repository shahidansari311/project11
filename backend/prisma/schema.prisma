generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  phone                String    @unique
  fullName             String?
  email                String?   @unique
  hasPurchasedProperty Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  sessions             Session[]
}

model Admin {
  id         String    @id @default(cuid())
  phone      String    @unique
  otp        String?
  otp_expiry DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sessions   Session[]
}

model Session {
  id                String   @id @default(cuid())
  userId            String?
  adminId           String?
  refreshToken      String   @unique
  deviceFingerprint String
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id         String   @id @default(cuid())
  phone      String   @unique
  otp        String
  otp_expiry DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
